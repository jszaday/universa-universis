  (fp_text reference RING1 (at 0 0) (layer F.SilkS) hide (effects (font (size 1 1) (thickness 0.15))))
  (fp_text value POPOUT (at 0 1) (layer F.Fab) hide (effects (font (size 1 1) (thickness 0.15))))
